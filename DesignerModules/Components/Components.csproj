<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputPath>..\..\bin\$(Configuration)\$(RuntimeIdentifier)\Designer\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TagEngine\TagEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Svg" Version="3.4.7" />
  </ItemGroup>

  <!-- Include Events module source files directly -->
  <ItemGroup>
    <Compile Include="..\Events\EventEnums.cs" Link="Events\EventEnums.cs" />
    <Compile Include="..\Events\EventTrigger.cs" Link="Events\EventTrigger.cs" />
    <Compile Include="..\Events\EventAction.cs" Link="Events\EventAction.cs" />
    <Compile Include="..\Events\ScadaEvent.cs" Link="Events\ScadaEvent.cs" />
    <Compile Include="..\Events\EventsModule.cs" Link="Events\EventsModule.cs" />
  </ItemGroup>

  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

</Project>
