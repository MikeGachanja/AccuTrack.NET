<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AccuTrack.Runtime.Views.MainWindow"
        Title="AccuTrack Runtime"
        Width="{Binding ResolutionWidth}"
        Height="{Binding ResolutionHeight}"
        MinWidth="800" MinHeight="600">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8">
            <Button Content="Logs" Command="{Binding LogsCommand}" />
            <Button Content="Alarms" Command="{Binding AlarmsCommand}" />
        </StackPanel>
        <!-- Main content -->
        <ContentControl Grid.Row="1" Content="{Binding Content}" Margin="8" />
        <!-- Status bar -->
        <Border Grid.Row="2" Background="#E0E0E0" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ItemsControl ItemsSource="{Binding ConnectionStatusList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <!-- Transfer overlay (covers full area when visible) -->
        <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding TransferVisible}" Background="#80000000" ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{Binding TransferStatus}" Foreground="White" />
                <ProgressBar Value="{Binding TransferProgress}" Maximum="100" Minimum="0" Width="300" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
