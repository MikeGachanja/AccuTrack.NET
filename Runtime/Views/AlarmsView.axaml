<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.AlarmsView"
             Background="White">
  <StackPanel Margin="10" Spacing="10">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button x:Name="BackButton" Content="← Back" Width="80" />
      <TextBlock Text="Alarms" FontSize="24" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center" />
    </StackPanel>
    <Border Background="White" BorderBrush="#cccccc" BorderThickness="1" CornerRadius="4">
      <ItemsControl x:Name="AlarmsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#f0f0f0" Margin="2" Padding="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" Foreground="#333333" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding State}" Foreground="#ff8800" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Time}" Foreground="#666666" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </StackPanel>
</UserControl>
