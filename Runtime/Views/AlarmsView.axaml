<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.AlarmsView"
             Background="#1e1e1e">
  <StackPanel Margin="10" Spacing="10">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button x:Name="BackButton" Content="← Back" Width="80" />
      <TextBlock Text="Alarms" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
    </StackPanel>
    <Border Background="#2b2b2b" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
      <ItemsControl x:Name="AlarmsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#3a3a3a" Margin="2" Padding="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding State}" Foreground="#ffa500" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Time}" Foreground="#a0a0a0" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </StackPanel>
</UserControl>
