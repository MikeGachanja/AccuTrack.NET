<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.Controls.RuntimeAlarmView">
  <Border Background="White" BorderBrush="#cccccc" BorderThickness="1" CornerRadius="4" Padding="8">
    <StackPanel>
      <TextBlock x:Name="TitleText" Text="Alarms" Foreground="#333333" FontSize="12" FontWeight="SemiBold" />
      <TextBlock x:Name="PlaceholderText" Text="Alarm list (stub)" Foreground="#666666" FontSize="11" Margin="0,6,0,0" />
    </StackPanel>
  </Border>
</UserControl>
