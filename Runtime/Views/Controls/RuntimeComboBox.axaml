<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.Controls.RuntimeComboBox">
  <StackPanel>
    <TextBlock x:Name="LabelText" Text="" Foreground="#333333" FontSize="11" IsVisible="False" />
    <ComboBox x:Name="TheComboBox" MinWidth="100" Background="White" Foreground="#333333" />
  </StackPanel>
</UserControl>
