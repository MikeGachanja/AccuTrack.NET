<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.Controls.RuntimeGaugeView">
  <Border x:Name="GaugeBorder" Background="#2b2b2b" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
    <StackPanel Margin="8">
      <TextBlock x:Name="LabelText" Text="" Foreground="White" FontSize="12" />
      <TextBlock x:Name="ValueText" Text="0" Foreground="#7fdbff" FontSize="24" FontWeight="Bold" />
    </StackPanel>
  </Border>
</UserControl>
