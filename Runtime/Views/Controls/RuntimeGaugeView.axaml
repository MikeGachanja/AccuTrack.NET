<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.Controls.RuntimeGaugeView">
  <Border x:Name="GaugeBorder" Background="White" BorderBrush="#cccccc" BorderThickness="1" CornerRadius="4">
    <StackPanel Margin="8">
      <TextBlock x:Name="LabelText" Text="" Foreground="#333333" FontSize="12" />
      <TextBlock x:Name="ValueText" Text="0" Foreground="#0066cc" FontSize="24" FontWeight="Bold" />
    </StackPanel>
  </Border>
</UserControl>
