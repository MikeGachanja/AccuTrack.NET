<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             x:Class="Runtime.Views.Controls.RuntimeGaugeView">
  <Canvas x:Name="GaugeCanvas" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <!-- Gauge background circle -->
    <Ellipse x:Name="GaugeBackground" Fill="White" Stroke="#808080" StrokeThickness="1" />
    <!-- Gauge arc -->
    <Path x:Name="GaugeArc" StrokeThickness="8" StrokeLineCap="Round" />
    <!-- Needle line -->
    <shapes:Line x:Name="NeedleLine" StrokeThickness="3" />
    <!-- Center dot -->
    <Ellipse x:Name="CenterDot" Width="10" Height="10" />
    <!-- Min/Max labels -->
    <TextBlock x:Name="MinLabel" FontSize="8" Foreground="Black" />
    <TextBlock x:Name="MaxLabel" FontSize="8" Foreground="Black" />
    <!-- Value text -->
    <TextBlock x:Name="ValueText" FontSize="12" FontWeight="Bold" Foreground="Black" TextAlignment="Center" />
  </Canvas>
</UserControl>
