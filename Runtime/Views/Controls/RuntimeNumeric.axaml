<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.Controls.RuntimeNumeric">
  <StackPanel>
    <TextBlock x:Name="LabelText" Text="" Foreground="#333333" FontSize="11" IsVisible="False" />
    <TextBlock x:Name="ValueText" Text="0" Foreground="#0066cc" FontSize="18" FontWeight="SemiBold" />
  </StackPanel>
</UserControl>
