<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.Controls.RuntimeNumeric">
  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left" 
              MinWidth="50" MinHeight="20">
    <TextBlock x:Name="LabelText" Text="" Foreground="#333333" FontSize="11" IsVisible="False" VerticalAlignment="Center" />
    <TextBlock x:Name="ValueText" Text="0" Foreground="#0066cc" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
  </StackPanel>
</UserControl>
