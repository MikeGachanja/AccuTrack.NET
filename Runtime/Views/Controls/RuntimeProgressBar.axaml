<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.Controls.RuntimeProgressBar">
  <StackPanel>
    <TextBlock x:Name="LabelText" Text="" Foreground="#333333" FontSize="11" IsVisible="False" />
    <ProgressBar x:Name="TheProgressBar" Minimum="0" Maximum="100" Value="0" Height="16" />
  </StackPanel>
</UserControl>
