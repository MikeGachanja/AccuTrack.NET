<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.Controls.RuntimePump">
  <StackPanel>
    <Ellipse x:Name="TheEllipse" Width="28" Height="28" Fill="Gray" />
    <TextBlock x:Name="LabelText" Text="Pump" Foreground="#333333" FontSize="10" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
