<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.Controls.RuntimeSlider">
  <StackPanel>
    <TextBlock x:Name="LabelText" Text="" Foreground="#333333" FontSize="11" IsVisible="False" />
    <Slider x:Name="TheSlider" Minimum="0" Maximum="100" Value="0" Width="120" />
  </StackPanel>
</UserControl>
