<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.Controls.RuntimeTableView">
  <Border Background="#252525" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8">
    <StackPanel>
      <TextBlock x:Name="TitleText" Text="Table" Foreground="White" FontSize="12" FontWeight="SemiBold" />
      <TextBlock Text="Data grid (stub)" Foreground="#606060" FontSize="11" Margin="0,6,0,0" />
    </StackPanel>
  </Border>
</UserControl>
