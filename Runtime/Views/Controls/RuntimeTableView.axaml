<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.Controls.RuntimeTableView">
  <Border Background="White" BorderBrush="#cccccc" BorderThickness="1" CornerRadius="4" Padding="8">
    <StackPanel>
      <TextBlock x:Name="TitleText" Text="Table" Foreground="#333333" FontSize="12" FontWeight="SemiBold" />
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
        <StackPanel x:Name="DataPanel" />
      </ScrollViewer>
    </StackPanel>
  </Border>
</UserControl>
