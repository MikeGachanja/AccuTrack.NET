<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.Controls.RuntimeTank">
  <StackPanel>
    <TextBlock x:Name="LabelText" Text="" Foreground="White" FontSize="11" HorizontalAlignment="Center" IsVisible="False" />
    <Border x:Name="TankBorder" Background="#333" BorderBrush="Gray" BorderThickness="1" CornerRadius="2" MinHeight="40">
      <Border x:Name="FillBorder" Background="#0a7" VerticalAlignment="Bottom" CornerRadius="0" Height="0" />
    </Border>
  </StackPanel>
</UserControl>
