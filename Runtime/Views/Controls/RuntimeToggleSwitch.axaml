<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.Controls.RuntimeToggleSwitch">
  <StackPanel>
    <ToggleSwitch x:Name="TheSwitch" OffContent="" OnContent="" />
    <TextBlock x:Name="LabelText" Text="" Foreground="#333333" FontSize="10" IsVisible="False" />
  </StackPanel>
</UserControl>
