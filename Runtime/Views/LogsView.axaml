<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runtime.Views.LogsView"
             Background="White">
  <StackPanel Margin="10" Spacing="10">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button x:Name="BackButton" Content="← Back" Width="80" />
      <TextBlock Text="Logs" FontSize="24" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center" />
      <Button x:Name="ClearButton" Content="Clear Logs" Width="100" />
    </StackPanel>
    <Border Background="White" BorderBrush="#cccccc" BorderThickness="1" CornerRadius="4">
      <ScrollViewer>
        <ItemsControl x:Name="LogList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Line}" Foreground="#333333" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="2,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </StackPanel>
</UserControl>
