<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Runtime.Views.MainWindow"
        Title="Runtime"
        Width="1024"
        Height="768"
        MinWidth="640"
        MinHeight="480"
        Background="White">
  <Panel>
    <DockPanel>
      <!-- Bottom: connection status strip -->
      <Border DockPanel.Dock="Bottom" Background="#f0f0f0" Padding="8,5" MinHeight="28">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="Connections:" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center" FontSize="12" />
          <ItemsControl x:Name="ConnectionStatusList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="White" Padding="5,2" CornerRadius="3" BorderThickness="1" BorderBrush="#cccccc">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Name}" Foreground="#333333" FontSize="11" />
                    <TextBlock Text="{Binding Status}" Foreground="#666666" FontSize="10" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Main content: full-screen view only (fills remaining space, no border/margin) -->
      <ContentControl x:Name="ScreenContainer" />
    </DockPanel>

    <!-- Transfer progress overlay (hidden by default) -->
    <Border x:Name="TransferOverlay"
            IsVisible="False"
            Background="#80000000"
            ZIndex="1000">
      <Border Background="White" BorderBrush="#cccccc" BorderThickness="2" CornerRadius="8"
              Width="400" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Margin="20" Spacing="15">
          <TextBlock x:Name="TransferTitle" Text="Project Transfer" FontSize="18" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center" />
          <TextBlock x:Name="TransferStatus" Text="Preparing transfer..." Foreground="#666666" FontSize="14" HorizontalAlignment="Center" />
          <ProgressBar x:Name="TransferProgressBar" Minimum="0" Maximum="100" Value="0" Height="20" />
          <TextBlock x:Name="TransferProgressText" Text="0%" Foreground="#333333" FontSize="12" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
